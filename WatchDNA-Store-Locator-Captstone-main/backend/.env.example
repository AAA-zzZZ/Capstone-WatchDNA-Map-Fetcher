# Copy to .env and fill in values.

# Database
DATABASE_URL=

# Auth
JWT_SECRET=

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173


# Brand claim reconcile after each scrape save: "true" auto-removes stale brand claims
# (guarded); anything else = report-only in the job logs.
SCRAPER_RECONCILE_EXECUTE=false
